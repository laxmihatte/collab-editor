# Reverse proxy and TLS termination.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically, which is
# why there is no certbot step anywhere in this setup. It needs ports 80 and
# 443 open and the domain's DNS already pointing here.

{$DOMAIN} {
	encode zstd gzip

	# Socket.io must be matched before the catch-all. It starts as an HTTP
	# long-poll and upgrades to a WebSocket; Caddy forwards the upgrade
	# headers on its own, so no extra configuration is needed.
	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	header {
		# HSTS: after the first visit, browsers refuse to talk to this host
		# over plain http at all.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
